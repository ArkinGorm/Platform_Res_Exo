# ── Ollama (local) ───────────────────────────────────────────────────────────
# Si tu lances Django directement sur ta machine (sans Docker) :
OLLAMA_BASE_URL=http://localhost:11434
# Si tu lances Django dans Docker, utilise host.docker.internal (déjà dans docker-compose) :
# OLLAMA_BASE_URL=http://host.docker.internal:11434

OLLAMA_MODEL=qwen2.5-coder:7b

