# ── Mode d'exécution ─────────────────────────────────────────────────────────
# "local"  → synchrone, sans Celery ni Redis (pour développer sans Docker)
# "celery" → asynchrone avec Redis + Celery (pour Docker / production)
EXECUTION_MODE=local

# ── Ollama ────────────────────────────────────────────────────────────────────
# Décommente la ligne qui correspond à ton environnement :
OLLAMA_BASE_URL=http://localhost:11434            # ← Sans Docker (local)
# OLLAMA_BASE_URL=http://host.docker.internal:11434  # ← Avec Docker

OLLAMA_MODEL=qwen2.5-coder:1.5b

